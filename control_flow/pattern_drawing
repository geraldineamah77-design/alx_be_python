#!/usr/bin/env python3

# pattern_drawing.py
# Draws a square pattern of asterisks using a while loop and nested for loop.

def main():
    # Prompt user for size
    size_input = input("Enter the size of the pattern: ")

    # Validate user input
    if not size_input.isdigit():
        print("Invalid input. Please enter a positive integer.")
        return

    size = int(size_input)

    if size <= 0:
        print("Size must be a positive integer.")
        return

    # Draw pattern using while loop (rows)
    row = 0
    while row < size:
        # Draw each row using for loop (columns)
        for _ in range(size):
            print("*", end="")
        print()  # Move to next line
        row += 1


if __name__ == "__main__":
    main()
